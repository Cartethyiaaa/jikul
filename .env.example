# =============================================================
# ENVIRONMENT VARIABLES UNTUK VERCEL DEPLOYMENT
# Pasang variabel berikut di Project Settings -> Environment Variables pada Dashboard Vercel
# =============================================================

# 1. Google OAuth 2.0 Client ID (Diperoleh dari Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# 2. Email yang diperbolehkan login secara eksklusif (Case-insensitive)
ALLOWED_EMAIL=jculinary06@gmail.com

# 3. Secret key acak untuk menandatangani HttpOnly Session Token JWT
SESSION_SECRET=kage_japanese_culinary_secret_key_session_token_2026_9999

# 4. Vercel Postgres / Neon Database Connection URL
# Otomatis terisi saat menghubungkan Postgres di Vercel Dashboard (Storage -> Create Database -> Postgres/Neon)
POSTGRES_URL=postgres://default:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
DATABASE_URL=postgres://default:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
